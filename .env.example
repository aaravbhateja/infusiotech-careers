# Frontend (public values; safe to expose). Copy to .env.local for `npm run dev`.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backend secrets are NOT stored here. Set them on Supabase instead:
#   supabase secrets set RAZORPAY_KEY_ID=rzp_test_xxx RAZORPAY_KEY_SECRET=xxx PRICE_INR=1499 \
#     RAZORPAY_WEBHOOK_SECRET=xxx ALLOWED_ORIGINS=https://infusiotech.careers,http://localhost:5173
